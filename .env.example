
# Serveur HTTP
HOST=127.0.0.1
PORT=3000

# Obligatoire : remplacer par un secret aleatoire long avant utilisation.
# Generation possible : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# PostgreSQL local : creer cette base avant de demarrer le serveur.
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=fc26
DB_USERNAME=postgres
DB_PASSWORD=change_me

# Alternative distante : decommenter et remplacer avec les vrais identifiants.
# DATABASE_URL est prioritaire sur toutes les variables DB_* ci-dessus.
# Le code impose SSL quand DATABASE_URL est renseignee.
# Pour une base locale sans SSL, conserver les variables DB_*.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
